<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="145-1" author="benedikt">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="segment_efforts" columnName="file_hash"/>
            </not>
        </preConditions>
        <comment>Add file_hash (SHA-256 of the uploaded bytes) to reject re-uploads of the exact same GPX file</comment>
        <addColumn tableName="segment_efforts">
            <column name="file_hash" type="VARCHAR(64)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="145-2" author="benedikt">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="segment_efforts" indexName="idx_segment_efforts_challenge_file_hash"/>
            </not>
        </preConditions>
        <comment>Index on (challenge_id, file_hash) for fast duplicate-file lookup</comment>
        <createIndex tableName="segment_efforts" indexName="idx_segment_efforts_challenge_file_hash">
            <column name="challenge_id"/>
            <column name="file_hash"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
