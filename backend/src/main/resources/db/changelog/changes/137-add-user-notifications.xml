<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="137-1" author="claude">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="user_notifications"/></not>
        </preConditions>
        <comment>Create user_notifications table for generic in-app notifications</comment>
        <createTable tableName="user_notifications">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="message" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="link_path" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="reference_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="read_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="user_notifications" baseColumnNames="user_id"
            referencedTableName="users" referencedColumnNames="id"
            constraintName="fk_user_notifications_user"
            onDelete="CASCADE"/>
        <createIndex tableName="user_notifications" indexName="idx_user_notifications_user_read">
            <column name="user_id"/>
            <column name="read_at"/>
        </createIndex>
        <createIndex tableName="user_notifications" indexName="idx_user_notifications_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
