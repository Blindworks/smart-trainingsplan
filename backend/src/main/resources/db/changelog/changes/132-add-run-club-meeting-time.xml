<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="132-1" author="benedikt">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="run_clubs" columnName="meeting_time"/>
            </not>
        </preConditions>
        <comment>Add meeting_time column to run_clubs for the recurring meeting clock time</comment>
        <addColumn tableName="run_clubs">
            <column name="meeting_time" type="TIME"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
